---
// Gabarit de la page méthode — jalons + règle d'avenant, stack + propriété du code, remote async.
// Contrat de testabilité : data-section="milestones|stack|remote" (EARS-31/32/33).
import Layout from '../layouts/Layout.astro';
import CtaBand from './CtaBand.astro';
import type { Locale, MethodPage } from '../content/site';

interface Props {
  locale: Locale;
  /** Chemin canonique — doit exister dans src/content/routes.ts. */
  path: string;
  page: MethodPage;
}

const { locale, path, page } = Astro.props;
---

<Layout locale={locale} title={page.meta.title} description={page.meta.description} path={path}>
  <main>
    <section class="hero" data-section="hero">
      <span class="kicker">{page.hero.kicker}</span>
      <h1>{page.hero.title}</h1>
      <p class="lead">{page.hero.lead}</p>
    </section>

    <section class="block" data-section="milestones">
      <h2>{page.milestones.title}</h2>
      <p class="body">{page.milestones.text}</p>
      <div class="rule">
        <h3>{page.scopeRule.title}</h3>
        <p>{page.scopeRule.text}</p>
      </div>
    </section>

    <section class="block" data-section="stack">
      <h2>{page.stack.title}</h2>
      <p class="body">{page.stack.text}</p>
      <div class="rule">
        <h3>{page.ownership.title}</h3>
        <p>{page.ownership.text}</p>
      </div>
    </section>

    <section class="block" data-section="remote">
      <h2>{page.remote.title}</h2>
      <p class="body">{page.remote.text}</p>
    </section>

    <CtaBand locale={locale} />
  </main>
</Layout>

<style>
  .hero {
    max-width: var(--nxi-page-max);
    margin: 0 auto;
    padding: 88px var(--nxi-gutter) 56px;
  }
  .kicker { font: 500 var(--nxi-meta) var(--nxi-mono); letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--nxi-copper-deep); }
  h1 { font: 600 var(--nxi-hero) var(--nxi-display); line-height: 1.08;
    letter-spacing: var(--nxi-track-display); max-width: 20ch; margin-top: 16px; }
  .lead { margin-top: 18px; color: var(--nxi-muted-l); max-width: 62ch; }

  .block { max-width: var(--nxi-page-max); margin: 0 auto; padding: 48px var(--nxi-gutter); }
  h2 { font: 600 26px var(--nxi-display); letter-spacing: var(--nxi-track-display); }
  .body { margin-top: 14px; color: var(--nxi-muted-l); max-width: 68ch; }

  .rule { margin-top: 28px; border-left: 3px solid var(--nxi-copper); padding-left: 20px;
    max-width: 72ch; }
  .rule h3 { font: 600 var(--nxi-h3) var(--nxi-display);
    letter-spacing: var(--nxi-track-display); }
  .rule p { margin-top: 8px; color: var(--nxi-muted-l); }

  @media (max-width: 900px) {
    .hero { padding: 40px 20px 32px; }
    .block { padding: 36px 20px; }
  }
</style>
