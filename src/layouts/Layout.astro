---
// Layout de base — hreflang croisés EN/FR, meta par page.
import '../styles/fonts.css';
import '../styles/tokens.css';
import type { Locale } from '../content/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Chemin de la page équivalente dans l'autre langue (ex. '/fr/' pour '/'). */
  altPath: string;
  /** Chemin canonique de cette page. */
  path: string;
}

const { locale, title, description, altPath, path } = Astro.props;
const site = 'https://nexusinsight.io';
const altLocale = locale === 'en' ? 'fr' : 'en';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + path} />
    <link rel="alternate" hreflang={locale} href={site + path} />
    <link rel="alternate" hreflang={altLocale} href={site + altPath} />
    <link rel="alternate" hreflang="x-default" href={site + (locale === 'en' ? path : altPath)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site + path} />
  </head>
  <body>
    <slot />
  </body>
</html>
