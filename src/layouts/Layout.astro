---
// Layout de base — canonical/hreflang/x-default dérivés du registre des routes, OG, favicon.
// Toutes les pages héritent de la nav (avant le slot) et du footer (après).
import '../styles/fonts.css';
import '../styles/tokens.css';
import type { Locale } from '../content/site';
import { paire } from '../content/routes';
import { organizationLd } from '../content/schema';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Chemin canonique de cette page — doit exister dans le registre src/content/routes.ts. */
  path: string;
  /** Blocs JSON-LD additionnels (ex. Service des pages package). */
  jsonLd?: object[];
}

const { locale, title, description, path, jsonLd = [] } = Astro.props;
const site = 'https://nexusinsight.io';
const r = paire(path);
const ldBlocks = [organizationLd(), ...jsonLd];

// Umami self-hosted (instance mutualisée kaan-personal-system) — seule requête externe autorisée
// du site : amendement documenté du no-go NG-2 de site-v1 (2026-08-19, demande Kaan), whitelistée
// dans tests/pages.test.ts (EARS-4).
const UMAMI_SRC = 'https://umami-857615578903.europe-west1.run.app/script.js';
const UMAMI_ID = '61a82e9d-79f0-4f61-bff9-e80dbbbfa395';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {r.noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={site + path} />
    <link rel="alternate" hreflang="en" href={site + r.en} />
    <link rel="alternate" hreflang="fr" href={site + r.fr} />
    <link rel="alternate" hreflang="x-default" href={site + r.en} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site + path} />
    <meta property="og:image" content={`${site}/og/og-${locale}.png`} />
    {ldBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <script defer src={UMAMI_SRC} data-website-id={UMAMI_ID}></script>
  </head>
  <body>
    <Nav locale={locale} path={path} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
